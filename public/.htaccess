<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  # index.html sin caché: si el navegador guardaba una copia, tras un despliegue seguía cargando la
  # versión anterior del CRM (visto en producción 2026-09-26). Los assets llevan hash en el nombre,
  # así que esos sí pueden cachearse sin riesgo.
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/crm/"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /crm/
  RewriteRule ^index\.html$ - [L]
  # Un fichero de assets/ o icons/ que no existe (chunk de un despliegue anterior) devuelve 404, no
  # el index.html: si no, el service worker del móvil lo guardaba como si fuera el JavaScript y esa
  # pantalla quedaba rota para siempre (auditoría 2026-10-01).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(assets|icons)/ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /crm/index.html [L]
</IfModule>
